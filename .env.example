# Jira Cloud - Basic Auth (e-mail + API token, não a senha da conta).
# Gere o token em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://nordwareservices.atlassian.net
JIRA_EMAIL=seu-email@nordware.io
JIRA_API_TOKEN=

# Intervalo de checagem, em segundos (padrão: 120 = 2 minutos).
ARGUS_INTERVALO_POLLING_SEGUNDOS=120

# Quantas janelas de detalhes DESTACADAS podem ficar abertas ao mesmo tempo
# (padrão: 5) - ao atingir o limite, o Argus avisa e pede pra fechar/reanexar
# uma antes de destacar outra.
ARGUS_LIMITE_JANELAS_DESTACADAS=5
